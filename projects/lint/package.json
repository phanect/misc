{
  "name": "@phanect/lint",
  "version": "2026.4.27",
  "description": "Personal ESLint configuration for Jumpei Ogawa (@phanect)",
  "author": "Jumpei Ogawa (https://phanective.org)",
  "license": "CC0-1.0",
  "homepage": "https://github.com/phanect/misc",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/phanect/misc.git"
  },
  "type": "module",
  "files": [
    "./dist",
    "./README.md"
  ],
  "main": "./dist/eslint.mjs",
  "module": "./dist/eslint.mjs",
  "types": "./dist/eslint.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/eslint.d.mts",
        "default": "./dist/eslint.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "tsc --noEmit && : lint"
  },
  "dependencies": {
    "@eslint/css": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-jsonc": "^3.1.1",
    "eslint-plugin-n": "^17.7.0",
    "eslint-plugin-promise": "^7.0.0",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "@phanect/configs": "workspace:*",
    "@types/node": "^24.3.0",
    "eslint": "^10.0.2",
    "tsdown": "0.21.10",
    "typescript": "^6.0.2",
    "vitest": "^4.0.4"
  },
  "peerDependencies": {
    "eslint": "^10.0.2",
    "next": "*",
    "svelte": "*",
    "typescript": ">=5.x"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "20.x || 22.x || >=24.x",
    "pnpm": ">=10.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
