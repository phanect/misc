{
  "name": "@phanect/configs",
  "version": "2026.8.29",
  "description": "Collection of @phanect's personal build configs",
  "author": "Jumpei Ogawa (https://phanective.org)",
  "license": "CC0-1.0",
  "homepage": "https://github.com/phanect/configs",
  "repository": {
    "type": "git",
    "url": "git@github.com:phanect/configs.git"
  },
  "type": "module",
  "files": [
    "./configs",
    "./dist",
    "./README.md"
  ],
  "exports": {
    "./ts": "./configs/ts/tsconfig.default.json",
    "./ts/nodejs": "./configs/ts/tsconfig.nodejs.json",
    "./ts/addons/npm": "./configs/ts/addons/tsconfig.npm.json",
    "./ts/importable": {
      "types": "./dist/tsconfigs.d.mts",
      "default": "./dist/tsconfigs.mjs"
    },
    "./tsdown": {
      "types": "./dist/tsdown.d.mts",
      "default": "./dist/tsdown.mjs"
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jiti": "^2.5.1",
    "tsdown": "0.22.14",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@types/node": "22.x || 24.x || >=26.x",
    "tsdown": "0.22.14",
    "typescript": "^6.0.2"
  },
  "peerDependenciesMeta": {
    "tsdown": {
      "optional": true
    }
  },
  "engines": {
    "node": "22.x || 24.x || >=26.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
