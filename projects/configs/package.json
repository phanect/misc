{
  "name": "@phanect/configs",
  "version": "2026.4.28",
  "description": "Collection of @phanect's personal build configs",
  "author": "Jumpei Ogawa (https://phanective.org)",
  "license": "CC0-1.0",
  "homepage": "https://github.com/phanect/misc",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/phanect/misc.git"
  },
  "type": "module",
  "files": [
    "./configs",
    "./dist",
    "./README.md"
  ],
  "exports": {
    "./ts": "./configs/ts/tsconfig.default.json",
    "./ts/nodejs": "./configs/ts/tsconfig.nodejs.json",
    "./ts/addons/npm": "./configs/ts/addons/tsconfig.npm.json",
    "./ts/importable": {
      "types": "./dist/tsconfigs.d.mts",
      "default": "./dist/tsconfigs.mjs"
    },
    "./tsdown": {
      "types": "./dist/tsdown.d.mts",
      "default": "./dist/tsdown.mjs"
    }
  },
  "scripts": {
    "build": "jiti ./scripts/build-prep.ts && tsdown",
    "lint": "tsc --noEmit && : configs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "jiti": "^2.5.1",
    "tsdown": "0.21.10",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@types/node": "20.x || 22.x || >=24.x",
    "tsdown": "0.21.10",
    "typescript": ">=5.x"
  },
  "peerDependenciesMeta": {
    "tsdown": {
      "optional": true
    }
  },
  "engines": {
    "node": "20.x || 22.x || >=24.x",
    "pnpm": ">=10.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
