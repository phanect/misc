{
  "name": "@phanect/lint-svelte",
  "version": "2025.11.29",
  "description": "@phanect's personal ESLint config for Svelte & SvelteKit projects",
  "author": "Jumpei Ogawa (https://phanective.org)",
  "license": "CC0-1.0",
  "homepage": "https://github.com/phanect/misc",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/phanect/misc.git"
  },
  "type": "module",
  "files": [
    "./dist",
    "./README.md"
  ],
  "main": "./dist/svelte.mjs",
  "module": "./dist/svelte.mjs",
  "types": "./dist/svelte.d.mts",
  "scripts": {
    "build": "tsdown",
    "lint": "tsc --noEmit && : lint-svelte"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.24.1",
    "eslint-plugin-svelte": "^3.0.2",
    "globals": "^17.0.0"
  },
  "devDependencies": {
    "@phanect/configs": "workspace:*",
    "@types/node": "^24.3.0",
    "eslint": "^10.1.0",
    "tsdown": "0.21.7",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@phanect/lint": "workspace:*",
    "eslint": "^10.1.0",
    "svelte": "*"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "engines": {
    "node": "20.x || 22.x || >=24.x",
    "pnpm": ">=10.x"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
