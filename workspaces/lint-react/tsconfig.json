{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // for eslint-plugin-jsx-a11y and eslint-plugin-react
    "esModuleInterop": true,

    "types": [
      "node",
      "eslint-plugin-jsx-a11y"
    ]
  },
  "include": [ "**/*.js", "**/*.mjs", "**/*.ts" ],
  "exclude": [ "dist" ],
}
